# Copy this file to .env and fill in the values.

# Supabase -> Project Settings -> Database -> Connection string ->
# "Session pooler". Paste it WITHOUT any "?sslmode=..." at the end.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> Database -> SSL configuration ->
# Download certificate. Save it next to this file and put its path here.
DATABASE_CA_CERTIFICATE_PATH=./supabase-ca.crt

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Secret key: ONLY on this server, never in the frontend. Used to upload product photos.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Order alerts (web push), free. Make your own keys once with:
#   npx web-push generate-vapid-keys
# The private key stays on this server. SUBJECT is how push services can reach you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Websites allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 when the server runs behind one reverse proxy (nginx, Caddy),
# so request limits see each visitor's real IP address.
TRUST_PROXY=

PORT=3000

# Docker on the server only: the address Caddy gets an HTTPS certificate for.
# Point this name's DNS A record at the server first.
API_DOMAIN=api.yourdomain.com
