# Copy this file to .env and fill in the values.
# Supabase -> Project Settings -> API Keys. The publishable key is safe
# to ship to the browser; NEVER put the secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Leave empty in development. In production: your Express API address,
# e.g. https://api.yourstore.in
VITE_API_URL=
